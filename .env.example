# ===================================
# Developer Workspace Environment
# ===================================
# 이 파일을 .env로 복사 후 실제 값을 입력하세요
# cp .env.example .env

# Python UTF-8 encoding
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Node environment
NODE_ENV=development

# --- 프로젝트별 변수 (아래에 추가) ---
# DATABASE_URL=
# API_KEY=
# VERCEL_TOKEN=
